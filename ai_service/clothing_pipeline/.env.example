
# ==================================================
# GardropAI Clothing Pipeline
# Example environment configuration
# ==================================================

# Application
GARDROPAI_APP_NAME="GardropAI Clothing Pipeline"
GARDROPAI_ENVIRONMENT=development

# HTTP server
GARDROPAI_HOST=127.0.0.1
GARDROPAI_PORT=8001

# Logging
GARDROPAI_LOG_LEVEL=INFO

# Inference
# auto | cpu | cuda
GARDROPAI_DEVICE=auto

# auto: CUDA mixed FP16, CPU FP32. Explicit fp32/fp16 overrides are supported.
GARDROPAI_MARQO_PRECISION=auto

# Maximum number of simultaneous GPU jobs
GARDROPAI_MAX_CONCURRENT_GPU_JOBS=1

# Maximum uploaded image size in MB
GARDROPAI_MAX_UPLOAD_MB=20
